          "steps": [
            {
              "run": "Start-Process \"http://localhost:8888\""
            }
          ]
        },
        "Jupyter - Open Lab UI": {
          "steps": [
            {
              "run": "Start-Process \"http://localhost:8889\""
            }
          ]
        },
        "Jupyter - Stop Servers": {
          "steps": [
            {
              "run": "Get-CimInstance Win32_Process -Filter \"Name='python.exe'\" | Where-Object { $_.CommandLine -like '*jupyter*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }"
            }
          ]
        },
        "Jupyter - Launch Docker Desktop": {
          "steps": [
            {
              "run": "Start-Process \"C:\\\\Program Files\\\\Docker\\\\Docker\\\\Docker Desktop.exe\""
            }
          ]
        },
        "Jupyter - Docker Compose up": {
          "cwd": "G:\\A-Jupyter\\Jupyter",
          "steps": [
            {
              "run": "docker compose -f docker-compose.yml up -d"
            }
          ]
        }
      },
