{
  "version": 2,
  "globals": {
    "defaultShell": "pwsh",
    "vars": {
      "browserEditorExe": "G:\\BrowserProject\\bin\\Debug\\net8.0-windows\\BrowserAI.exe",
      "jupyterPython": "C:\\Users\\janko\\.venvs\\devshell-jupyter\\Scripts\\python.exe",
      "nodeDirectory": "C:\\Users\\janko\\AppData\\Local\\DevShellLauncher\\runtime\\node_modules\\node\\bin",
      "math3dEnvironment": "C:\\Users\\janko\\anaconda3\\envs\\math3d-cgal",
      "math3dPython": "C:\\Users\\janko\\anaconda3\\envs\\math3d-cgal\\python.exe",
      "basePython": "C:\\Users\\janko\\anaconda3\\python.exe"
    },
    "terminal": {
      "fontSize": 14,
      "scrollback": 5000
    }
  },
  "templates": {},
  "projects": [
    {
      "id": "github",
      "name": "GitHub Repos",
      "root": "C:\\Users\\janko\\OneDrive\\Desktop\\DEVSHELL",
      "vars": {
        "math3dRepoPath": "G:\\Function-viewer-2026-02-05\\Math3D",
        "math3dRepoUrl": "https://github.com/expert10000/Math3D",
        "theoryRepoPath": "C:\\Users\\janko\\OneDrive\\Desktop\\THEORY",
        "theoryRepoUrl": "https://github.com/expert10000/theory",
        "mathRepoPath": "C:\\Users\\janko\\OneDrive\\Dokumenty\\MATH",
        "mathRepoUrl": "https://github.com/expert10000/math",
        "devshellRepoPath": "C:\\Users\\janko\\OneDrive\\Desktop\\DEVSHELL\\devshell-launcher",
        "devshellRepoUrl": "https://github.com/expert10000/devshell-launcher"
      },
      "layout": {
        "type": "tabs",
        "items": [
          {
            "title": "Math3D",
            "profileId": "pwsh",
            "cwd": "${vars.math3dRepoPath}"
          },
          {
            "title": "Theory",
            "profileId": "pwsh",
            "cwd": "${vars.theoryRepoPath}"
          },
          {
            "title": "Math",
            "profileId": "pwsh",
            "cwd": "${vars.mathRepoPath}"
          },
          {
            "title": "DevShell",
            "profileId": "pwsh",
            "cwd": "${vars.devshellRepoPath}",
            "autoRun": false
          }
        ]
      },
      "tasks": {
        "Launcher health check": {
          "shell": "pwsh",
          "steps": [
            {
              "run": "$browserEditor = '${vars.browserEditorExe}'; $repoPaths = @('${vars.math3dRepoPath}', '${vars.theoryRepoPath}', '${vars.mathRepoPath}', '${vars.devshellRepoPath}'); $errors = @(); if (-not (Test-Path $browserEditor)) { $errors += \"BrowserEditor missing: $browserEditor\" }; if (-not (Get-Command code -ErrorAction SilentlyContinue)) { $errors += \"VS Code CLI missing (command: code)\" }; $repoPaths | ForEach-Object { if (-not (Test-Path $_)) { $errors += \"Repo path missing: $_\" } }; if ($errors.Count -gt 0) { Write-Host 'Launcher health check failed:'; $errors | ForEach-Object { Write-Host \" - $_\" }; exit 1 }; Write-Host 'Launcher health check passed.'"
            }
          ]
        },
        "Open active URL in BrowserEditor": {
          "shell": "pwsh",
          "steps": [
            {
              "run": "$url = (Get-Clipboard | Out-String).Trim(); if ([string]::IsNullOrWhiteSpace($url)) { $url = Read-Host 'Paste repository URL' }; if ([string]::IsNullOrWhiteSpace($url)) { Write-Host 'No URL provided.'; exit 1 }; $browserEditor = '${vars.browserEditorExe}'; $opened = $false; if (Test-Path -LiteralPath $browserEditor) { foreach ($attempt in 1..2) { try { Start-Process -FilePath $browserEditor -ArgumentList @($url) -ErrorAction Stop; $opened = $true; break } catch { if ($attempt -lt 2) { Start-Sleep -Milliseconds 500 } } } }; if (-not $opened) { Write-Warning 'BrowserEditor could not be started; opening the outer browser.'; Start-Process $url }"
            }
          ]
        },
        "Math3D - GitHub (BrowserEditor)": {
          "shell": "pwsh",
          "steps": [
            {
              "run": "$url = '${vars.math3dRepoUrl}'; $browserEditor = '${vars.browserEditorExe}'; try { if (-not (Test-Path -LiteralPath $browserEditor)) { throw 'BrowserEditor missing' }; Start-Process -FilePath $browserEditor -ArgumentList @($url) -ErrorAction Stop } catch { Write-Warning 'Opening Math3D in the outer browser.'; Start-Process $url }"
            }
          ]
        },
        "Math3D - GitHub (outer browser)": {
          "shell": "pwsh",
          "steps": [
            {
              "run": "Start-Process '${vars.math3dRepoUrl}'"
            }
          ]
        },
        "Math3D - Open in VS Code": {
          "shell": "pwsh",
          "cwd": "${vars.math3dRepoPath}",
          "steps": [
            {
              "run": "Start-Process code -ArgumentList '.'"
            }
          ]
        },
        "Theory - GitHub (BrowserEditor)": {
          "shell": "pwsh",
          "steps": [
            {
              "run": "$url = '${vars.theoryRepoUrl}'; $browserEditor = '${vars.browserEditorExe}'; try { if (-not (Test-Path -LiteralPath $browserEditor)) { throw 'BrowserEditor missing' }; Start-Process -FilePath $browserEditor -ArgumentList @($url) -ErrorAction Stop } catch { Write-Warning 'Opening Theory in the outer browser.'; Start-Process $url }"
            }
          ]
        },
        "Theory - GitHub (outer browser)": {
          "shell": "pwsh",
          "steps": [
            {
              "run": "Start-Process '${vars.theoryRepoUrl}'"
            }
          ]
        },
        "Theory - Open in VS Code": {
          "shell": "pwsh",
          "cwd": "${vars.theoryRepoPath}",
          "steps": [
            {
              "run": "Start-Process code -ArgumentList '.'"
            }
          ]
        },
        "Math - GitHub (BrowserEditor)": {
          "shell": "pwsh",
          "steps": [
            {
              "run": "$url = '${vars.mathRepoUrl}'; $browserEditor = '${vars.browserEditorExe}'; try { if (-not (Test-Path -LiteralPath $browserEditor)) { throw 'BrowserEditor missing' }; Start-Process -FilePath $browserEditor -ArgumentList @($url) -ErrorAction Stop } catch { Write-Warning 'Opening Math in the outer browser.'; Start-Process $url }"
            }
          ]
        },
        "Math - GitHub (outer browser)": {
          "shell": "pwsh",
          "steps": [
            {
              "run": "Start-Process '${vars.mathRepoUrl}'"
            }
          ]
        },
        "Math - Open in VS Code": {
          "shell": "pwsh",
          "cwd": "${vars.mathRepoPath}",
          "steps": [
            {
              "run": "Start-Process code -ArgumentList '.'"
            }
          ]
        },
        "DevShell - Open in VS Code": {
          "shell": "pwsh",
          "cwd": "${vars.devshellRepoPath}",
          "steps": [
            {
              "run": "code ."
            }
          ]
        },
        "DevShell - GitHub": {
          "shell": "pwsh",
          "steps": [
            {
              "run": "Start-Process '${vars.devshellRepoUrl}'"
            }
          ]
        },
        "DevShell - Build": {
          "steps": [
            {
              "run": "npm --prefix DevShell/ui/dev-ui-react run build; if ($LASTEXITCODE -eq 0) { dotnet build BatchLauncher/BatchLauncher.csproj --configuration Debug }"
            }
          ],
          "cwd": "${vars.devshellRepoPath}",
          "runInNewTab": true,
          "shell": "pwsh"
        },
        "Theory - Build PDF": {
          "steps": [
            {
              "run": "latexmk -pdf main.tex"
            }
          ],
          "cwd": "${vars.theoryRepoPath}",
          "runInNewTab": true,
          "shell": "pwsh"
        },
        "Theory - Open PDF": {
          "steps": [
            {
              "run": "if (Test-Path 'build/main.pdf') { Start-Process 'build/main.pdf' } else { Write-Error 'Build the PDF first.' }"
            }
          ],
          "cwd": "${vars.theoryRepoPath}",
          "runInNewTab": true,
          "shell": "pwsh"
        },
        "Math3D - Run": {
          "steps": [
            {
              "run": "$env:MATH3D_PYTHON = '${vars.math3dPython}'; $env:PATH = '${vars.nodeDirectory};${vars.math3dEnvironment};${vars.math3dEnvironment}\\Library\\bin;${vars.math3dEnvironment}\\Scripts;' + $env:PATH; npm run dev"
            }
          ],
          "cwd": "${vars.math3dRepoPath}",
          "runInNewTab": true,
          "shell": "pwsh"
        },
        "Math3D - Build": {
          "steps": [
            {
              "run": "$env:MATH3D_PYTHON = '${vars.math3dPython}'; $env:PATH = '${vars.nodeDirectory};${vars.math3dEnvironment};${vars.math3dEnvironment}\\Library\\bin;${vars.math3dEnvironment}\\Scripts;' + $env:PATH; npm run build:core"
            }
          ],
          "cwd": "${vars.math3dRepoPath}",
          "runInNewTab": true,
          "shell": "pwsh"
        },
        "DevShell - Run": {
          "steps": [
            {
              "run": "Start-Process 'BatchLauncher/bin/Debug/net8.0-windows/BatchLauncher.exe'"
            }
          ],
          "cwd": "${vars.devshellRepoPath}",
          "runInNewTab": true,
          "shell": "pwsh"
        },
        "Math3D - GitHub (DevShell)": {
          "url": "${vars.math3dRepoUrl}",
          "type": "browser",
          "group": "Math3D"
        },
        "Theory - GitHub (DevShell)": {
          "url": "${vars.theoryRepoUrl}",
          "type": "browser",
          "group": "Theory"
        },
        "Math - GitHub (DevShell)": {
          "url": "${vars.mathRepoUrl}",
          "type": "browser",
          "group": "Math"
