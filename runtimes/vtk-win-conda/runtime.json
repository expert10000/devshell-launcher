{
  "schemaVersion": 1,
  "id": "vtk-win-conda",
  "kind": "vtk",
  "execution": "windows-native",
  "description": "Isolated VTK Python probes. C++ SDK and rendering checks remain separate.",
  "qualificationRecipes": [
    { "id": "compile-link", "readinessLevel": "L4", "capability": "vtk.cpp.compile-link" },
    { "id": "l5.worker", "readinessLevel": "L5", "capability": "mesh.read",
      "positive": { "recipeId": "mesh.inspect", "datasetId": "math3d/basic/01_tetrahedron.obj", "outputName": "l5-positive.vtp" },
      "rejection": { "recipeId": "mesh.inspect", "datasetId": "math3d/import/truncated-ascii.ply", "outputName": "l5-rejected.vtp", "expectedReason": "surface is empty" } },
    { "id": "l6.reproduce", "readinessLevel": "L6", "capability": "mesh.read", "referenceRecipe": "l5.worker", "comparison": "sha256-exact" },
    { "id": "l7.math3d-import", "readinessLevel": "L7", "capability": "mesh.interop.math3d", "referenceRecipe": "l6.reproduce", "consumer": "MATH3D desktop loadSurfaceMeshFromFile" }
    ,{ "id": "l5.vtk-read", "readinessLevel": "L5", "capability": "mesh.read", "suiteId": "vtk-mesh-read-v3", "positiveCases": 9, "rejectionCases": 3, "fixtureManifest": "scientific/fixtures/vtk/read/manifest.v3.json" }
    ,{ "id": "l6.vtk-read", "readinessLevel": "L6", "capability": "mesh.read", "referenceRecipe": "l5.vtk-read", "comparison": "state-and-output-sha256" }
    ,{ "id": "l7.vtk-read", "readinessLevel": "L7", "capability": "mesh.read", "referenceRecipe": "l6.vtk-read", "consumer": "VTK and MATH3D desktop mesh import" }
    ,{ "id": "l8.vtk-read", "readinessLevel": "L8", "capability": "mesh.read", "referenceRecipe": "l7.vtk-read", "checks": ["repeat", "cancel", "timeout", "memory"] }
    ,{ "id": "l9.vtk-read", "readinessLevel": "L9", "capability": "mesh.read", "referenceRecipe": "l8.vtk-read", "viewer": "MeshDocumentViewport" }
  ],
  "probes": [
    {
      "id": "python.version",
      "readinessLevel": "L1",
      "timeoutSeconds": 15,
      "arguments": ["-I", "-c", "import sys; print(sys.version); print(sys.executable)"]
    },
    {
      "id": "vtk.python",
      "readinessLevel": "L2",
      "capability": "vtk.python.import",
      "timeoutSeconds": 20,
      "arguments": ["-I", "-c", "from vtkmodules.vtkCommonCore import vtkVersion; print(vtkVersion.GetVTKVersion())"]
    },
    {
      "id": "vtk.polydata",
      "readinessLevel": "L3",
      "capability": "geometry.polydata",
      "timeoutSeconds": 20,
      "arguments": ["-I", "-c", "from vtkmodules.vtkCommonDataModel import vtkPolyData; print(vtkPolyData().GetNumberOfPoints())"]
    }
  ]
}
