{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.devshell.local/scientific-sage-exact.v1.json",
  "title": "Sage exact worker request",
  "type": "object",
  "required": ["schemaVersion", "runId", "runtimeId", "recipeId", "operation", "parameters", "workingDirectory"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "runtimeId": { "const": "sage-wsl" },
    "recipeId": { "const": "sage.exact.v1" },
    "operation": { "enum": ["rational.add", "polynomial.factor", "matrix.solve"] },
    "workingDirectory": { "type": "string" },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
    "parameters": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "operation": { "const": "rational.add" } } },
      "then": { "properties": { "parameters": { "type": "object", "required": ["left", "right"], "properties": { "left": { "$ref": "#/$defs/rational" }, "right": { "$ref": "#/$defs/rational" } }, "additionalProperties": false } } } },
    { "if": { "properties": { "operation": { "const": "polynomial.factor" } } },
      "then": { "properties": { "parameters": { "type": "object", "required": ["coefficients"], "properties": { "coefficients": { "type": "array", "minItems": 2, "maxItems": 7, "items": { "$ref": "#/$defs/rational" } } }, "additionalProperties": false } } } },
    { "if": { "properties": { "operation": { "const": "matrix.solve" } } },
      "then": { "properties": { "parameters": { "type": "object", "required": ["matrix", "rhs"], "properties": { "matrix": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "array", "items": { "$ref": "#/$defs/rational" } } }, "rhs": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "$ref": "#/$defs/rational" } } }, "additionalProperties": false } } } }
  ],
  "additionalProperties": false,
  "$defs": {
    "rational": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "string", "pattern": "^-?(0|[1-9][0-9]{0,17})$" },
        "denominator": { "type": "string", "pattern": "^-?[1-9][0-9]{0,17}$" }
      },
      "additionalProperties": false
    }
  }
}
