{
  "schemaVersion": 1,
  "id": "cgal-win-conda",
  "kind": "cgal",
  "execution": "windows-native",
  "description": "Isolated Python binding probes for the local CGAL Conda prefix. C++ SDK checks remain separate.",
  "qualificationRecipes": [
    { "id": "compile-link", "readinessLevel": "L4", "capability": "cgal.cpp.compile-link" },
    { "id": "l5.worker", "readinessLevel": "L5", "capability": "mesh.validate",
      "positive": { "recipeId": "cgal.validate", "datasetId": "math3d/basic/01_tetrahedron.obj", "outputName": "l5-positive.obj" },
      "rejection": { "recipeId": "cgal.validate", "datasetId": "math3d/problematic/18_degenerate_faces.obj", "outputName": "l5-rejected.obj", "expectedReason": "not a readable manifold polygon mesh" } },
    { "id": "l5.cgal-repair", "readinessLevel": "L5", "capability": "mesh.repair",
      "suiteId": "cgal-repair-qualification-v1", "positiveCases": 4, "rejectionCases": 2,
      "fixtureManifest": "scientific/fixtures/cgal-repair-qualification/manifest.json" },
    { "id": "l6.reproduce", "readinessLevel": "L6", "capability": "mesh.validate", "referenceRecipe": "l5.worker", "comparison": "sha256-exact" },
    { "id": "l7.cgal-vtk-math3d", "readinessLevel": "L7", "capability": "mesh.interop.vtk-math3d", "referenceRecipe": "l6.reproduce", "format": "obj" },
    { "id": "l8.resilience", "readinessLevel": "L8", "capability": "mesh.interop.vtk-math3d", "referenceRecipe": "l7.cgal-vtk-math3d", "repeatCount": 3, "memoryLimitBytes": 134217728 },
    { "id": "l9.math3d-product", "readinessLevel": "L9", "capability": "mesh.interop.vtk-math3d", "referenceRecipe": "l8.resilience", "contractVersion": 1, "viewer": "MeshDocumentViewport" }
  ],
  "recipes": [
    {
      "id": "cgal.validate",
      "adapter": "tools/scientific-cgal-worker.py",
      "capability": "mesh.validate",
      "timeoutSeconds": 120
    },
    {
      "id": "cgal.fill-one-hole",
      "adapter": "tools/scientific-cgal-hole-repair-worker.py",
      "capability": "mesh.repair",
      "timeoutSeconds": 120
    },
    {
      "id": "cgal.fill-quad-hole",
      "adapter": "tools/scientific-cgal-hole-repair-worker.py",
      "capability": "mesh.repair",
      "timeoutSeconds": 120
    },
    {
      "id": "cgal.fill-two-quad-holes",
      "adapter": "tools/scientific-cgal-hole-repair-worker.py",
      "capability": "mesh.repair",
      "timeoutSeconds": 120
    },
    {
      "id": "cgal.fill-bounded-holes",
      "adapter": "tools/scientific-cgal-hole-repair-worker.py",
      "capability": "mesh.repair",
      "timeoutSeconds": 120
    }
  ],
  "testMatrix": [
    {
      "id": "tetrahedron",
      "datasetId": "math3d/basic/01_tetrahedron.obj",
      "name": "Tetrahedron",
      "expected": "succeeded",
      "reason": ""
    },
    {
      "id": "cube",
      "datasetId": "math3d/basic/02_cube.obj",
      "name": "Cube",
      "expected": "succeeded",
      "reason": ""
    },
    {
      "id": "degenerate-faces",
      "datasetId": "math3d/problematic/18_degenerate_faces.obj",
      "name": "Degenerate faces",
      "expected": "rejected",
      "reason": "not a readable manifold polygon mesh"
    }
  ],
  "probes": [
    {
      "id": "python.version",
      "readinessLevel": "L1",
      "timeoutSeconds": 15,
      "arguments": ["-I", "-c", "import sys; print(sys.version); print(sys.executable)"]
    },
    {
      "id": "cgal.python",
      "readinessLevel": "L2",
      "capability": "cgal.python.import",
      "timeoutSeconds": 20,
      "arguments": ["-I", "-c", "import CGAL; print(CGAL.__file__)"]
    },
    {
      "id": "cgal.geometry",
      "readinessLevel": "L3",
      "capability": "geometry.point3",
      "timeoutSeconds": 20,
      "arguments": ["-I", "-c", "from CGAL.CGAL_Kernel import Point_3; p = Point_3(1, 2, 3); print(p)"]
    }
  ]
}
