{
  "schemaVersion": 1,
  "id": "cgal-win-conda",
  "kind": "cgal",
  "execution": "windows-native",
  "description": "Isolated Python binding probes for the local CGAL Conda prefix. C++ SDK checks remain separate.",
  "recipes": [
    {
      "id": "cgal.validate",
      "adapter": "tools/scientific-cgal-worker.py",
      "capability": "mesh.validate",
      "timeoutSeconds": 120
    }
  ],
  "testMatrix": [
    {
      "id": "tetrahedron",
      "datasetId": "math3d/basic/01_tetrahedron.obj",
      "name": "Tetrahedron",
      "expected": "succeeded",
      "reason": ""
    },
    {
      "id": "cube",
      "datasetId": "math3d/basic/02_cube.obj",
      "name": "Cube",
      "expected": "succeeded",
      "reason": ""
    },
    {
      "id": "degenerate-faces",
      "datasetId": "math3d/problematic/18_degenerate_faces.obj",
      "name": "Degenerate faces",
      "expected": "rejected",
      "reason": "not a readable manifold polygon mesh"
    }
  ],
  "probes": [
    {
      "id": "python.version",
      "readinessLevel": "L1",
      "timeoutSeconds": 15,
      "arguments": ["-I", "-c", "import sys; print(sys.version); print(sys.executable)"]
    },
    {
      "id": "cgal.python",
      "readinessLevel": "L2",
      "capability": "cgal.python.import",
      "timeoutSeconds": 20,
      "arguments": ["-I", "-c", "import CGAL; print(CGAL.__file__)"]
    },
    {
      "id": "cgal.geometry",
      "readinessLevel": "L3",
      "capability": "geometry.point3",
      "timeoutSeconds": 20,
      "arguments": ["-I", "-c", "from CGAL.CGAL_Kernel import Point_3; p = Point_3(1, 2, 3); print(p)"]
    }
  ]
}
