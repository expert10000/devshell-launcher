          "cwd": "C:\\Users\\janko\\OneDrive\\Desktop\\DEVSHELL\\jupyter-playground",
          "steps": [
            {
              "run": "python -m jupyter lab --no-browser --port=8889 --NotebookApp.token='' --NotebookApp.password=''"
            }
          ]
        },
