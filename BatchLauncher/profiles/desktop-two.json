      },
      "tasks": {
        "Jupyter - Install / Upgrade": {
          "cwd": "C:\\Users\\janko\\OneDrive\\Desktop\\DEVSHELL\\jupyter-playground",
          "steps": [
            {
              "run": "python -m pip install jupyter"
            }
          ]
