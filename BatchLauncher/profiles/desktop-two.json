          "cwd": "C:\\Users\\janko\\OneDrive\\Desktop\\DEVSHELL\\jupyter-playground",
          "steps": [
            {
              "run": "python -m jupyter notebook list"
            }
          ]
        },
        "Jupyter - Start Notebook": {
          "cwd": "C:\\Users\\janko\\OneDrive\\Desktop\\DEVSHELL\\jupyter-playground",
          "steps": [
            {
              "run": "python -m notebook --no-browser --port=8888 --NotebookApp.token='' --NotebookApp.password=''"
            }
