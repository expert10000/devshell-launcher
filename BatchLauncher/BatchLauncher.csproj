<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" ExcludeAssets="buildTransitive" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(NuGetPackageRoot)microsoft.web.webview2\1.0.2903.40\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>$(NuGetPackageRoot)microsoft.web.webview2\1.0.2903.40\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2903.40\runtimes\win-x86\native\WebView2Loader.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\win-x86\native\WebView2Loader.dll</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2903.40\runtimes\win-x64\native\WebView2Loader.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\win-x64\native\WebView2Loader.dll</Link>
    </Content>
    <Content Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.2903.40\runtimes\win-arm64\native\WebView2Loader.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtimes\win-arm64\native\WebView2Loader.dll</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="scripts - Copy.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="scripts.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="profiles\**\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="_scripts.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="profile.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="service_control.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\tools\Sync-Repository.ps1" Link="tools\Sync-Repository.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\tools\Manage-Repository.ps1" Link="tools\Manage-Repository.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\tools\Inspect-ScientificRuntimes.ps1;..\tools\scientific-runtime-probe.py;..\tools\scientific-mesh-worker.py;..\tools\scientific-vtk-render-check.py;..\tools\scientific_worker_contract.py;..\tools\scientific-cgal-worker.py;..\tools\scientific-artifact-preview.py;..\tools\compare-math3d-native-worker.mjs;..\tools\math3d-boolean-fixtures.mjs;..\tools\math3d-mesh-comparison.mjs;..\tools\math3d-native-protocol.mjs;..\tools\run-math3d-boolean.mjs" Link="tools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\scientific\smoke\**\*" Link="scientific\smoke\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\tools\Setup-Environment.ps1" Link="tools\Setup-Environment.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\scientific\cgal-worker\**\*" Link="scientific\cgal-worker\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\tools\runtime-lab\RuntimeLab.csproj" ReferenceOutputAssembly="false" />
    <Content Include="..\runtimes\**\runtime.json" Link="runtimes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyRuntimeLab" AfterTargets="Build">
    <MSBuild Projects="..\tools\runtime-lab\RuntimeLab.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="RuntimeLabTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <RuntimeLabOutputDirectory>@(RuntimeLabTargetPath->'%(RootDir)%(Directory)')</RuntimeLabOutputDirectory>
    </PropertyGroup>
    <ItemGroup>
      <RuntimeLabOutput Include="$(RuntimeLabOutputDirectory)runtime-lab.*" />
    </ItemGroup>
    <Error Condition="!Exists('$(RuntimeLabOutputDirectory)runtime-lab.exe')" Text="The runtime-lab executable was not built." />
    <Copy SourceFiles="@(RuntimeLabOutput)" DestinationFolder="$(TargetDir)runtime-lab\" SkipUnchangedFiles="true" />
  </Target>
</Project>
